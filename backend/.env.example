POSTGRES_USER=servit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=servit

JWT_KEY=generate-a-new-random-secret-for-this-environment
JWT_ISSUER=Servit.Api
JWT_AUDIENCE=Servit.Client

GOOGLE_IOS_CLIENT_ID=123326191723-vgl4l913p2u3ftu5fdbjnia34mq8k9cb.apps.googleusercontent.com

# --- Panel administrativo (Fase 3) ---
# Credenciales del primer admin. El seeder las usa al arrancar (idempotente).
ADMIN_EMAIL=admin@tu-dominio.com
ADMIN_PASSWORD=change-me-strong-password

# Origen HTTPS del panel para CORS. Debe coincidir con el hostname publico del
# tunnel de Cloudflare (sin barra final), p. ej. https://panel.tu-dominio.com.
# El panel usa el proxy /api del mismo origen (nginx), asi que en la practica no
# necesita CORS; esta var restringe cualquier acceso cross-origin directo al API.
# Si se deja vacio, el API cae a AllowAnyOrigin (mobile sigue funcionando).
PANEL_ORIGIN=

# Token del tunnel gestionado de Cloudflare (Zero Trust > Networks > Tunnels).
# El mapeo hostname-publico -> http://admin:80 se configura en el dashboard.
CLOUDFLARE_TUNNEL_TOKEN=

# --- SMTP (recuperacion de contrasena) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Servit
